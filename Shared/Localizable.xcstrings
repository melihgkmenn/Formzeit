            "value": "Denetim Merkezi’ne basılı tut. Denetim Ekle’den Formzeit’i seç. Saat uygulamasına tek dokunuşla ulaş."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch and hold Control Center. Choose Formzeit from Add a Control. Open your clock with one tap."
          }
        },
        "de": {
          "stringUnit": {
