        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij biurko prawym przyciskiem. Dodaj Formzeit z Edytuj widżety. Dostępne rozmiary: mały, średni i duży."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique com o botão direito na mesa. Adicione Formzeit em Editar Widgets. Há tamanhos pequeno, médio e grande."
