    "Sessiz, yalın, zamansız.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessiz, yalın, zamansız."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet, simple, timeless."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Still, schlicht, zeitlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Calme, simple, intemporel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Silencioso, sencillo, atemporal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Silenzioso, semplice, senza tempo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هادئ، بسيط، خالد."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stille, enkel, tidløs."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rustig, eenvoudig, tijdloos."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiljainen, selkeä, ajaton."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenang, sederhana, abadi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静かに、シンプルに、時を超えて。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고요하고, 단순하고, 변함없이."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stille, enkel, tidløs."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spokojny, prosty, ponadczasowy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Calmo, simples, atemporal."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Liniștit, simplu, atemporal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тихий, простой, вне времени."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "宁静、简洁、永恒。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stilla, enkel, tidlös."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สงบ เรียบง่าย ไร้กาลเวลา"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tĩnh lặng, đơn giản, vượt thời gian."
          }
        }
      }
    },
    "Biraz su, biraz dinginlik.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biraz su, biraz dinginlik."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A little water, a little calm."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein wenig Wasser, ein wenig Ruhe."
