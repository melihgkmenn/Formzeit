        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번의 탭으로 탁상시계를 여세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne bordklokken med ett trykk."
          }
