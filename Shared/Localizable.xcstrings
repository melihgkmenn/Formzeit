    "Mac’te sürekli renk: Sistem Ayarları › Masaüstü ve Dock › Araç Takımları › Soluklaştırma: Asla.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac’te sürekli renk: Sistem Ayarları › Masaüstü ve Dock › Araç Takımları › Soluklaştırma: Asla."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always show colors on Mac: System Settings › Desktop & Dock › Widgets › Fade: Never."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Farben auf dem Mac immer anzeigen: Systemeinstellungen › Schreibtisch & Dock › Widgets › Verblassen: Nie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couleurs permanentes sur Mac : Réglages Système › Bureau et Dock › Widgets › Atténuation : Jamais."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Colores permanentes en Mac: Ajustes del Sistema › Escritorio y Dock › Widgets › Atenuar: Nunca."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Colori permanenti sul Mac: Impostazioni di Sistema › Scrivania e Dock › Widget › Attenuazione: Mai."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لإظهار الألوان دائمًا على Mac: إعدادات النظام › سطح المكتب وشريط الأيقونات › الأدوات › التلاشي: أبدًا."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis altid farver på Mac: Systemindstillinger › Skrivebord & Dock › Widgets › Udtoning: Aldrig."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Altijd kleuren op Mac: Systeeminstellingen › Bureaublad en Dock › Widgets › Vervagen: Nooit."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pidä värit Macissa: Järjestelmäasetukset › Työpöytä ja Dock › Widgetit › Häivytä: Ei koskaan."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selalu tampilkan warna di Mac: Pengaturan Sistem › Desktop & Dock › Widget › Pudar: Jangan Pernah."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Macで常にカラー表示：システム設定 › デスクトップとDock › ウィジェット › フェード：しない。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 항상 색상 표시: 시스템 설정 › 데스크탑 및 Dock › 위젯 › 흐리게: 안 함."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis alltid farger på Mac: Systeminnstillinger › Skrivebord og Dock › Widgeter › Ton ned: Aldri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawsze kolory na Macu: Ustawienia systemowe › Biurko i Dock › Widżety › Wygaszanie: Nigdy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre mostrar cores no Mac: Ajustes do Sistema › Mesa e Dock › Widgets › Esmaecer: Nunca."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Culori permanente pe Mac: Configurări sistem › Desktop și Dock › Widgeturi › Estompare: Niciodată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цвета на Mac всегда: Системные настройки › Рабочий стол и Dock › Виджеты › Приглушение: Никогда."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac始终显示颜色：系统设置 › 桌面与程序坞 › 小组件 › 淡化：永不。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa alltid färger på Mac: Systeminställningar › Skrivbord och Dock › Widgetar › Tona ned: Aldrig."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงสีบน Mac เสมอ: การตั้งค่าระบบ › เดสก์ท็อปและ Dock › วิดเจ็ต › จางลง: ไม่เลย"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Luôn hiện màu trên Mac: Cài đặt hệ thống › Màn hình nền & Dock › Tiện ích › Làm mờ: Không bao giờ."
          }
        }
      }
    },
