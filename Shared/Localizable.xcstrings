        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikkaa työpöytää oikealla painikkeella. Lisää Formzeit Muokkaa widgettejä -valikosta. Saatavilla pieni, keskikokoinen ja suuri koko."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik kanan desktop. Tambahkan Formzeit dari Edit Widget. Tersedia ukuran kecil, sedang, dan besar."
