    "Oturum süreni Kilit Ekranı ve Dynamic Island’da gör. İşin bittiğinde oturumu buradan bitir." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شاهد مدة جلستك على شاشة القفل وDynamic Island. أنهِ الجلسة هنا عند الانتهاء."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se sessionens varighed på låseskærmen og i Dynamic Island. Afslut sessionen her, når du er færdig."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sieh deine Sitzungsdauer auf dem Sperrbildschirm und in der Dynamic Island. Beende die Sitzung hier, wenn du fertig bist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "See your session duration on the Lock Screen and Dynamic Island. End the session here when finished."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta la duración de la sesión en la pantalla de bloqueo y Dynamic Island. Finaliza la sesión aquí al terminar."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näe istunnon kesto lukitulla näytöllä ja Dynamic Islandissa. Lopeta istunto tästä, kun olet valmis."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consultez la durée de session sur l’écran verrouillé et dans la Dynamic Island. Terminez la session ici une fois fini."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihat durasi sesi di Layar Terkunci dan Dynamic Island. Akhiri sesi di sini setelah selesai."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vedi la durata della sessione sulla schermata di blocco e sulla Dynamic Island. Termina la sessione qui quando hai finito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロック画面とDynamic Islandでセッション時間を確認できます。終わったらここで終了します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠금 화면과 Dynamic Island에서 세션 시간을 확인하세요. 끝나면 여기서 세션을 종료하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se øktens varighet på låst skjerm og Dynamic Island. Avslutt økten her når du er ferdig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bekijk je sessieduur op het toegangsscherm en Dynamic Island. Beëindig de sessie hier als je klaar bent."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź czas sesji na ekranie blokady i Dynamic Island. Po zakończeniu zamknij sesję tutaj."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veja a duração da sessão na Tela Bloqueada e na Dynamic Island. Encerre a sessão aqui ao terminar."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vezi durata sesiunii pe ecranul de blocare și în Dynamic Island. Încheie sesiunea aici când termini."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Смотрите длительность сеанса на экране блокировки и в Dynamic Island. Завершите сеанс здесь, когда закончите."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se sessionens längd på låsskärmen och i Dynamic Island. Avsluta sessionen här när du är klar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ดูระยะเวลาเซสชันบนหน้าจอล็อคและ Dynamic Island จบเซสชันที่นี่เมื่อเสร็จ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oturum süreni Kilit Ekranı ve Dynamic Island’da gör. İşin bittiğinde oturumu buradan bitir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Xem thời lượng phiên trên Màn hình khóa và Dynamic Island. Kết thúc phiên tại đây khi hoàn tất."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在锁定屏幕和灵动岛查看时段时长。完成后可在此结束。"
          }
        }
      }
    },
