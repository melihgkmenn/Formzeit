    "Bir bakış yeter.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir bakış yeter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One glance is enough."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Blick genügt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un regard suffit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta una mirada."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Basta uno sguardo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نظرة واحدة تكفي."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et blik er nok."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén blik is genoeg."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yksi vilkaisu riittää."
          }
        },
        "id": {
