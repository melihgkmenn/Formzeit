    "Her an, yerinde.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her an, yerinde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every moment, in place."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Moment am richtigen Platz."
          }
        },
        "fr": {
