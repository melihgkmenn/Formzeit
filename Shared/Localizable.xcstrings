        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sedikit air, sedikit ketenangan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水のような、穏やかさ。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조금의 물, 조금의 평온."
