    "Akrep, yelkovan ve saniye ibresi kesintisiz akar.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akrep, yelkovan ve saniye ibresi kesintisiz akar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hour, minute, and second hands glide continuously."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stunden-, Minuten- und Sekundenzeiger gleiten stufenlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les aiguilles des heures, minutes et secondes glissent en continu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las agujas de horas, minutos y segundos avanzan sin saltos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lancette di ore, minuti e secondi scorrono senza scatti."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتحرك عقارب الساعات والدقائق والثواني بانسياب متواصل."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Time-, minut- og sekundviseren glider jævnt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uur-, minuut- en secondewijzer bewegen vloeiend."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunti-, minuutti- ja sekuntiviisarit liikkuvat tasaisesti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jarum jam, menit, dan detik bergerak terus-menerus."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時針、分針、秒針がなめらかに動きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시침, 분침, 초침이 부드럽게 계속 움직입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Time-, minutt- og sekundviseren glir jevnt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskazówki godzin, minut i sekund poruszają się płynnie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ponteiros de hora, minuto e segundo deslizam continuamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acele de oră, minut și secundă se mișcă continuu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часовая, минутная и секундная стрелки движутся плавно."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时针、分针和秒针连续平滑移动。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tim-, minut- och sekundvisaren glider jämnt."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข็มชั่วโมง นาที และวินาทีเคลื่อนอย่างต่อเนื่อง"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kim giờ, phút và giây chuyển động liên tục."
          }
        }
      }
    },
    "İbreler saniyede bir, net adımlarla ilerler.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İbreler saniyede bir, net adımlarla ilerler."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hands advance in precise one-second steps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zeiger bewegen sich in präzisen Sekundenschritten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les aiguilles avancent par pas précis d’une seconde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las agujas avanzan en pasos precisos de un segundo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lancette avanzano con scatti precisi ogni secondo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتقدم العقارب بخطوات دقيقة كل ثانية."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Viserne bevæger sig i præcise sekundtrin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzers bewegen in precieze stappen van één seconde."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viisarit etenevät tarkoin sekunnin askelin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jarum bergerak dalam langkah tepat satu detik."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "針が1秒ごとに正確に進みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "바늘이 정확한 1초 간격으로 움직입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Viserne går i presise sekundtrinn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskazówki przesuwają się w precyzyjnych krokach co sekundę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ponteiros avançam em passos precisos de um segundo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acele avansează în pași preciși de o secundă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стрелки идут точными шагами раз в секунду."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "指针每秒精准跳动一次。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visarna går i exakta sekundsteg."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข็มเคลื่อนอย่างแม่นยำทีละหนึ่งวินาที"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kim chuyển động chính xác từng giây."
          }
        }
      }
    },
    "Akrep ve yelkovan dakikada bir ilerler. Saniye ibresi gizlenir.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akrep ve yelkovan dakikada bir ilerler. Saniye ibresi gizlenir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hour and minute hands advance once a minute. The second hand is hidden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stunden- und Minutenzeiger bewegen sich einmal pro Minute. Der Sekundenzeiger ist ausgeblendet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les aiguilles des heures et minutes avancent une fois par minute. La trotteuse est masquée."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las agujas de horas y minutos avanzan una vez por minuto. El segundero se oculta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le lancette di ore e minuti avanzano una volta al minuto. La lancetta dei secondi è nascosta."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتقدم عقربا الساعات والدقائق مرة كل دقيقة. عقرب الثواني مخفي."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Time- og minutviseren går én gang i minuttet. Sekundviseren er skjult."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uur- en minuutwijzer bewegen eenmaal per minuut. De secondewijzer is verborgen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunti- ja minuuttiviisarit etenevät kerran minuutissa. Sekuntiviisari on piilotettu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jarum jam dan menit bergerak sekali per menit. Jarum detik disembunyikan."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時針と分針が1分ごとに進みます。秒針は非表示です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시침과 분침이 1분마다 움직입니다. 초침은 숨겨집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Time- og minuttviseren går én gang i minuttet. Sekundviseren er skjult."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wskazówki godzin i minut przesuwają się raz na minutę. Sekundnik jest ukryty."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ponteiros de hora e minuto avançam uma vez por minuto. O ponteiro de segundos fica oculto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acele de oră și minut avansează o dată pe minut. Secundarul este ascuns."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часовая и минутная стрелки движутся раз в минуту. Секундная стрелка скрыта."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时针和分针每分钟移动一次，秒针隐藏。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tim- och minutvisaren går en gång i minuten. Sekundvisaren är dold."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข็มชั่วโมงและนาทีเคลื่อนทุกหนึ่งนาที ซ่อนเข็มวินาที"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kim giờ và phút chuyển động mỗi phút. Kim giây được ẩn."
          }
        }
      }
    },
    "Akrep ve yelkovan ilerler; saniye ibresi görünmez.": {
      "extractionState": "manual",
      "localizations": {
