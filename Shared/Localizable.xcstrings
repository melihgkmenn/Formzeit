    "Kadran rengini, şehrini ve gece görünümünü seç.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kadran rengini, şehrini ve gece görünümünü seç."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose the dial color, city, and night appearance."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle Zifferblattfarbe, Stadt und Nachtansicht."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez la couleur du cadran, la ville et le mode nuit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el color de la esfera, la ciudad y el aspecto nocturno."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli colore del quadrante, città e aspetto notturno."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر لون قرص الساعة والمدينة والمظهر الليلي."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg urskivens farve, by og natvisning."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de wijzerplaatkleur, stad en nachtweergave."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Valitse kellotaulun väri, kaupunki ja yönäkymä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih warna pelat jam, kota, dan tampilan malam."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "文字盤の色、都市、夜の外観を選びます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "문자판 색, 도시, 야간 모양을 선택하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Velg urskivefarge, by og nattvisning."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz kolor tarczy, miasto i wygląd nocny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha a cor do mostrador, a cidade e a aparência noturna."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege culoarea cadranului, orașul și aspectul nocturn."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите цвет циферблата, город и ночное оформление."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择表盘颜色、城市和夜间外观。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj urtavlans färg, stad och nattutseende."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกสีหน้าปัด เมือง และรูปลักษณ์กลางคืน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn màu mặt đồng hồ, thành phố và giao diện ban đêm."
          }
        }
      }
    },
