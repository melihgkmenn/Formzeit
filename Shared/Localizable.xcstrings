            "state": "translated",
            "value": "Open je bureauklok met één tik."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa pöytäkello yhdellä napautuksella."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka jam meja dengan sekali ketuk."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ワンタップで置き時計を開きます。"
          }
