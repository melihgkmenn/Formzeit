    "Canlı Etkinlikler sistem ayarlarında kapalı.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı Etkinlikler sistem ayarlarında kapalı."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Activities are disabled in system settings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Aktivitäten sind in den Systemeinstellungen deaktiviert."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les activités en direct sont désactivées dans les réglages système."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las actividades en directo están desactivadas en los ajustes del sistema."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le attività in tempo reale sono disattivate nelle impostazioni di sistema."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأنشطة المباشرة معطلة في إعدادات النظام."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Liveaktiviteter er slået fra i systemindstillingerne."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Live activiteiten zijn uitgeschakeld in de systeeminstellingen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-aktiviteetit on poistettu käytöstä järjestelmän asetuksissa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivitas Langsung dinonaktifkan di pengaturan sistem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定でライブアクティビティが無効になっています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 실시간 현황이 꺼져 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Direkteaktiviteter er slått av i systeminnstillingene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktywności na żywo są wyłączone w ustawieniach systemowych."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Atividades ao Vivo estão desativadas nos ajustes do sistema."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activitățile live sunt dezactivate în configurările sistemului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эфир активности отключён в настройках системы."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统设置中已关闭实时活动。"
          }
        },
        "sv": {
