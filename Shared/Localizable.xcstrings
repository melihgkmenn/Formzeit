    "Masa saatine tek dokunuşla ulaş.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masa saatine tek dokunuşla ulaş."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open your desk clock with one tap."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne deine Tischuhr mit einem Tippen."
          }
