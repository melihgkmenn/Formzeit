          "stringUnit": {
            "state": "translated",
            "value": "Tryk for at åbne urets indstillinger."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik om klokinstellingen te openen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa kellon asetukset napauttamalla."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk untuk membuka pengaturan jam."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タップして時計の設定を開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "탭하여 시계 설정을 여세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk for å åpne klokkeinnstillinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij, aby otworzyć ustawienia zegara."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque para abrir os ajustes do relógio."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge pentru a deschide configurările ceasului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите, чтобы открыть настройки часов."
          }
        },
