        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một cái nhìn là đủ."
          }
        }
      }
    },
    "Ana ekranında, masanda, bileğinde. Zamanına kendi rengini ver.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana ekranında, masanda, bileğinde. Zamanına kendi rengini ver."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On your Home Screen, desk, and wrist. Give time your own color."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf dem Home-Bildschirm, dem Schreibtisch und am Handgelenk. Gib deiner Zeit Farbe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur votre écran d’accueil, votre bureau et votre poignet. Donnez votre couleur au temps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En tu pantalla de inicio, escritorio y muñeca. Dale tu color al tiempo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulla schermata Home, sulla scrivania e al polso. Dai al tempo il tuo colore."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "على شاشتك الرئيسية ومكتبك ومعصمك. امنح الوقت لونك الخاص."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "På hjemmeskærmen, bordet og håndleddet. Giv tiden din egen farve."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op je beginscherm, bureau en pols. Geef tijd je eigen kleur."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kotinäkymässä, pöydällä ja ranteessa. Anna ajalle oma värisi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di Layar Utama, meja, dan pergelangan tangan. Beri waktu warnamu sendiri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面でも、デスクでも、手首でも。時に、あなたの色を。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "홈 화면, 책상, 손목에서. 시간에 나만의 색을 입히세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "På Hjem-skjermen, bordet og håndleddet. Gi tiden din egen farge."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na ekranie początkowym, biurku i nadgarstku. Nadaj czasowi własny kolor."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Na Tela de Início, na mesa e no pulso. Dê ao tempo sua própria cor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pe ecranul principal, pe birou și la încheietură. Dă timpului culoarea ta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На экране «Домой», на столе и на запястье. Придайте времени свой цвет."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在主屏幕、桌面和腕间，赋予时间你的色彩。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "På hemskärmen, skrivbordet och handleden. Ge tiden din egen färg."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บนหน้าจอโฮม โต๊ะทำงาน และข้อมือ แต่งแต้มเวลาในสีของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trên Màn hình chính, bàn và cổ tay. Tô thời gian bằng màu của bạn."
          }
        }
      }
    },
