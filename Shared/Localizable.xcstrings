    "Akrep ve yelkovan dakikada bir ilerler. Saniye ibresi gizlenir." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتقدم عقربا الساعات والدقائق مرة كل دقيقة. عقرب الثواني مخفي."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time- og minutviseren går én gang i minuttet. Sekundviseren er skjult."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stunden- und Minutenzeiger bewegen sich einmal pro Minute. Der Sekundenzeiger ist ausgeblendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hour and minute hands advance once a minute. The second hand is hidden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las agujas de horas y minutos avanzan una vez por minuto. El segundero se oculta."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunti- ja minuuttiviisarit etenevät kerran minuutissa. Sekuntiviisari on piilotettu."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les aiguilles des heures et minutes avancent une fois par minute. La trotteuse est masquée."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jarum jam dan menit bergerak sekali per menit. Jarum detik disembunyikan."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lancette di ore e minuti avanzano una volta al minuto. La lancetta dei secondi è nascosta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時針と分針が1分ごとに進みます。秒針は非表示です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시침과 분침이 1분마다 움직입니다. 초침은 숨겨집니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time- og minuttviseren går én gang i minuttet. Sekundviseren er skjult."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uur- en minuutwijzer bewegen eenmaal per minuut. De secondewijzer is verborgen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wskazówki godzin i minut przesuwają się raz na minutę. Sekundnik jest ukryty."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os ponteiros de hora e minuto avançam uma vez por minuto. O ponteiro de segundos fica oculto."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acele de oră și minut avansează o dată pe minut. Secundarul este ascuns."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Часовая и минутная стрелки движутся раз в минуту. Секундная стрелка скрыта."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tim- och minutvisaren går en gång i minuten. Sekundvisaren är dold."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เข็มชั่วโมงและนาทีเคลื่อนทุกหนึ่งนาที ซ่อนเข็มวินาที"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akrep ve yelkovan dakikada bir ilerler. Saniye ibresi gizlenir."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kim giờ và phút chuyển động mỗi phút. Kim giây được ẩn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "时针和分针每分钟移动一次，秒针隐藏。"
          }
        }
      }
    },
    "Akrep ve yelkovan ilerler; saniye ibresi görünmez." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتحرك عقربا الساعات والدقائق دون عقرب الثواني."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time- og minutviseren bevæger sig uden sekundviser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stunden- und Minutenzeiger bewegen sich ohne Sekundenzeiger."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hour and minute hands move without a second hand."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las agujas de horas y minutos avanzan sin segundero."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tunti- ja minuuttiviisarit liikkuvat ilman sekuntiviisaria."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les aiguilles des heures et minutes avancent sans trotteuse."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jarum jam dan menit bergerak tanpa jarum detik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lancette di ore e minuti avanzano senza lancetta dei secondi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時針と分針のみが動き、秒針は表示されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "초침 없이 시침과 분침이 움직입니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Time- og minuttviseren går uten sekundviser."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uur- en minuutwijzer bewegen zonder secondewijzer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wskazówki godzin i minut poruszają się bez sekundnika."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os ponteiros de hora e minuto se movem sem ponteiro de segundos."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acele de oră și minut se mișcă fără secundar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Часовая и минутная стрелки движутся без секундной."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tim- och minutvisaren går utan sekundvisare."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เข็มชั่วโมงและนาทีเคลื่อนโดยไม่มีเข็มวินาที"
          }
        },
        "tr" : {
          "stringUnit" : {
