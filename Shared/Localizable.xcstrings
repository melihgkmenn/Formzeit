    "Tam ekranda dokunarak kontrolleri gizleyebilirsin. Duo’da katlandığında saat ve kontroller ayrı bölgelere yerleşir.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam ekranda dokunarak kontrolleri gizleyebilirsin. Duo’da katlandığında saat ve kontroller ayrı bölgelere yerleşir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap in full screen to hide controls. When Duo is folded, the clock and controls move into separate regions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe im Vollbild, um die Steuerung auszublenden. Beim Falten des Duo werden Uhr und Steuerung getrennt angeordnet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez le plein écran pour masquer les commandes. Quand Duo est plié, l’horloge et les commandes occupent des zones distinctes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca en pantalla completa para ocultar los controles. Al plegar el Duo, el reloj y los controles ocupan zonas separadas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca a schermo intero per nascondere i controlli. Quando Duo è piegato, orologio e controlli occupano aree separate."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط في وضع ملء الشاشة لإخفاء عناصر التحكم. عند طي Duo، تنتقل الساعة وعناصر التحكم إلى منطقتين منفصلتين."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk i fuld skærm for at skjule betjeningen. Når Duo foldes, flyttes ur og betjening til separate områder."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik in volledig scherm om bediening te verbergen. Als Duo wordt gevouwen, komen klok en bediening in aparte delen."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Piilota säätimet napauttamalla koko näytössä. Kun Duo taitetaan, kello ja säätimet siirtyvät eri alueille."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk layar penuh untuk menyembunyikan kontrol. Saat Duo dilipat, jam dan kontrol berpindah ke area terpisah."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全画面でタップするとコントロールを隠せます。Duoを折りたたむと、時計とコントロールが別々の領域に移ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 화면에서 탭하면 제어가 숨겨집니다. Duo를 접으면 시계와 제어가 별도 영역에 배치됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk i fullskjerm for å skjule kontroller. Når Duo foldes, flyttes klokke og kontroller til separate områder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij na pełnym ekranie, aby ukryć sterowanie. Po złożeniu Duo zegar i sterowanie trafiają do osobnych obszarów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em tela cheia para ocultar os controles. Ao dobrar o Duo, o relógio e os controles ficam em áreas separadas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge în ecran complet pentru a ascunde comenzile. Când Duo este pliat, ceasul și comenzile apar în zone separate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите в полноэкранном режиме, чтобы скрыть управление. При складывании Duo часы и управление размещаются в разных областях."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全屏时轻点可隐藏控制项。折叠Duo后，时钟和控制项会分别显示在不同区域。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck i helskärm för att dölja reglage. När Duo viks placeras klocka och reglage i separata områden."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะขณะเต็มหน้าจอเพื่อซ่อนตัวควบคุม เมื่อพับ Duo นาฬิกาและตัวควบคุมจะแยกพื้นที่กัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm khi toàn màn hình để ẩn điều khiển. Khi gập Duo, đồng hồ và điều khiển nằm ở hai vùng riêng."
          }
        }
      }
    },
    "Biçim ve zaman. Her gün yeniden.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Biçim ve zaman. Her gün yeniden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Form and time. A new day, every day."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Form und Zeit. Jeden Tag aufs Neue."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forme et temps. Chaque jour à nouveau."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Forma y tiempo. Cada día, de nuevo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Forma e tempo. Ogni giorno, di nuovo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الشكل والزمن. يوم جديد كل يوم."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Form og tid. En ny dag, hver dag."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorm en tijd. Elke dag een nieuwe dag."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Muoto ja aika. Uusi päivä joka päivä."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bentuk dan waktu. Hari baru, setiap hari."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "かたちと時間。毎日、新しい一日。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "형태와 시간. 매일 새로운 하루."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Form og tid. En ny dag, hver dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Forma i czas. Nowy dzień, każdego dnia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Forma e tempo. Um novo dia, todos os dias."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Formă și timp. O nouă zi, în fiecare zi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Форма и время. Каждый день заново."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "形态与时间，每天焕然一新。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Form och tid. En ny dag, varje dag."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปทรงและเวลา วันใหม่ในทุกวัน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hình dáng và thời gian. Mỗi ngày một khởi đầu."
          }
        }
      }
    },
