        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trochę wody, trochę spokoju."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pouco de água, um pouco de calma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Puțină apă, puțină liniște."
          }
        },
