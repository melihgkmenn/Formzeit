    "Masaüstüne sağ tıkla. Widget’ları Düzenle’den Formzeit’i ekle. Küçük, orta ve büyük boyutlar hazır." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر بزر الفأرة الأيمن على سطح المكتب. أضف Formzeit من تعديل الأدوات. تتوفر أحجام صغيرة ومتوسطة وكبيرة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Højreklik på skrivebordet. Tilføj Formzeit fra Rediger widgets. Der er små, mellemstore og store størrelser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klicke mit der rechten Maustaste auf den Schreibtisch. Füge Formzeit über Widgets bearbeiten hinzu. Kleine, mittlere und große Größen sind verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Right-click the desktop. Add Formzeit from Edit Widgets. Small, medium, and large sizes are available."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haz clic derecho en el escritorio. Añade Formzeit desde Editar widgets. Hay tamaños pequeño, mediano y grande."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klikkaa työpöytää oikealla painikkeella. Lisää Formzeit Muokkaa widgettejä -valikosta. Saatavilla pieni, keskikokoinen ja suuri koko."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Faites un clic droit sur le bureau. Ajoutez Formzeit depuis Modifier les widgets. Formats petit, moyen et grand disponibles."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik kanan desktop. Tambahkan Formzeit dari Edit Widget. Tersedia ukuran kecil, sedang, dan besar."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fai clic destro sulla scrivania. Aggiungi Formzeit da Modifica widget. Disponibili dimensioni piccola, media e grande."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "デスクトップを右クリックし、ウィジェットを編集からFormzeitを追加します。小、中、大のサイズがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데스크탑을 오른쪽 클릭하고 위젯 편집에서 Formzeit를 추가하세요. 소형, 중형, 대형이 제공됩니다."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Høyreklikk på skrivebordet. Legg til Formzeit fra Rediger widgeter. Små, mellomstore og store størrelser er tilgjengelige."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klik met rechts op het bureaublad. Voeg Formzeit toe via Wijzig widgets. Klein, middelgroot en groot zijn beschikbaar."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kliknij biurko prawym przyciskiem. Dodaj Formzeit z Edytuj widżety. Dostępne rozmiary: mały, średni i duży."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clique com o botão direito na mesa. Adicione Formzeit em Editar Widgets. Há tamanhos pequeno, médio e grande."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fă clic dreapta pe desktop. Adaugă Formzeit din Editează widgeturile. Sunt disponibile dimensiuni mici, medii și mari."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите правой кнопкой на рабочем столе. Добавьте Formzeit через изменение виджетов. Доступны малый, средний и большой размеры."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Högerklicka på skrivbordet. Lägg till Formzeit från Redigera widgetar. Små, medelstora och stora storlekar finns."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คลิกขวาบนเดสก์ท็อป เพิ่ม Formzeit จากแก้ไขวิดเจ็ต มีขนาดเล็ก กลาง และใหญ่"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masaüstüne sağ tıkla. Widget’ları Düzenle’den Formzeit’i ekle. Küçük, orta ve büyük boyutlar hazır."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bấm chuột phải trên màn hình nền. Thêm Formzeit từ Sửa tiện ích. Có kích thước nhỏ, vừa và lớn."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "右键点按桌面，从编辑小组件中添加Formzeit。支持小、中、大三种尺寸。"
          }
        }
      }
    },
