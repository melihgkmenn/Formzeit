    "Kilit Ekranı için sade analog saat, dijital saat ve saat dilimi." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ساعة واضحة بعقارب ووقت رقمي ومنطقة زمنية لشاشة القفل."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et tydeligt analogt ur, digital tid og tidszone til låseskærmen."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine klare Analoguhr, digitale Uhrzeit und Zeitzone für deinen Sperrbildschirm."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A clear analog clock, digital time, and time zone for your Lock Screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reloj analógico claro, hora digital y zona horaria para la pantalla de bloqueo."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selkeä analoginen kello, digitaalinen aika ja aikavyöhyke lukitulle näytölle."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une horloge analogique lisible, l’heure numérique et le fuseau pour l’écran verrouillé."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jam analog jelas, waktu digital, dan zona waktu untuk Layar Terkunci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orologio analogico leggibile, ora digitale e fuso orario per la schermata di blocco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロック画面に、見やすいアナログ時計、デジタル時刻、タイムゾーンを。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠금 화면을 위한 선명한 아날로그 시계, 디지털 시간, 시간대."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tydelig analog klokke, digital tid og tidssone for låst skjerm."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een heldere analoge klok, digitale tijd en tijdzone voor je toegangsscherm."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Czytelny zegar analogowy, czas cyfrowy i strefa czasowa na ekranie blokady."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Relógio analógico nítido, hora digital e fuso horário na Tela Bloqueada."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceas analogic clar, oră digitală și fus orar pe ecranul de blocare."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чёткие аналоговые часы, цифровое время и часовой пояс на экране блокировки."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En tydlig analog klocka, digital tid och tidszon för låsskärmen."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "นาฬิกาอะนาล็อกที่ชัดเจน เวลาดิจิทัล และเขตเวลาบนหน้าจอล็อค"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kilit Ekranı için sade analog saat, dijital saat ve saat dilimi."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Đồng hồ kim rõ nét, giờ kỹ thuật số và múi giờ trên Màn hình khóa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "锁定屏幕上的清晰模拟时钟、数字时间和时区。"
          }
        }
      }
    },
    "Kilit Ekranı’na basılı tut. Özelleştir › Kilit Ekranı › Widget Ekle › Formzeit. Dairesel, dikdörtgen veya satır içi saati seç." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مطولًا على شاشة القفل. تخصيص › شاشة القفل › إضافة أدوات › Formzeit. اختر ساعة دائرية أو مستطيلة أو مضمنة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold fingeren på låseskærmen. Tilpas › Låseskærm › Tilføj widgets › Formzeit. Vælg et rundt, rektangulært eller integreret ur."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte den Sperrbildschirm gedrückt. Anpassen › Sperrbildschirm › Widgets hinzufügen › Formzeit. Wähle eine runde, rechteckige oder einzeilige Uhr."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold the Lock Screen. Customize › Lock Screen › Add Widgets › Formzeit. Choose a circular, rectangular, or inline clock."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada la pantalla de bloqueo. Personalizar › Pantalla de bloqueo › Añadir widgets › Formzeit. Elige un reloj circular, rectangular o en línea."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä lukittua näyttöä painettuna. Muokkaa › Lukittu näyttö › Lisää widgettejä › Formzeit. Valitse pyöreä, suorakulmainen tai rivillä näkyvä kello."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez le doigt sur l’écran verrouillé. Personnaliser › Écran verrouillé › Ajouter des widgets › Formzeit. Choisissez une horloge circulaire, rectangulaire ou en ligne."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentuh dan tahan Layar Terkunci. Sesuaikan › Layar Terkunci › Tambah Widget › Formzeit. Pilih jam lingkaran, persegi panjang, atau sebaris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuta la schermata di blocco. Personalizza › Schermata di blocco › Aggiungi widget › Formzeit. Scegli un orologio circolare, rettangolare o in linea."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロック画面を長押しします。カスタマイズ › ロック画面 › ウィジェットを追加 › Formzeit。円形、長方形、またはインラインの時計を選びます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠금 화면을 길게 누르세요. 사용자화 › 잠금 화면 › 위젯 추가 › Formzeit에서 원형, 직사각형, 인라인 시계를 선택하세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold inne på låst skjerm. Tilpass › Låst skjerm › Legg til widgeter › Formzeit. Velg en rund, rektangulær eller innebygd klokke."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd het toegangsscherm ingedrukt. Pas aan › Toegangsscherm › Voeg widgets toe › Formzeit. Kies een ronde, rechthoekige of inline klok."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj ekran blokady. Dostosuj › Ekran blokady › Dodaj widżety › Formzeit. Wybierz zegar okrągły, prostokątny lub wierszowy."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha a Tela Bloqueada pressionada. Personalizar › Tela Bloqueada › Adicionar Widgets › Formzeit. Escolha um relógio circular, retangular ou em linha."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ține apăsat ecranul de blocare. Personalizează › Ecran de blocare › Adaugă widgeturi › Formzeit. Alege ceasul circular, dreptunghiular sau pe un rând."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте экран блокировки. Настроить › Экран блокировки › Добавить виджеты › Formzeit. Выберите круглые, прямоугольные или строчные часы."
