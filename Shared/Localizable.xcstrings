    "Denetim Merkezi’ne basılı tut. Denetim Ekle’den Formzeit’i seç. Saat uygulamasına tek dokunuşla ulaş." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مطولًا على مركز التحكم. اختر Formzeit من إضافة عنصر تحكم. افتح ساعتك بلمسة واحدة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold fingeren i Kontrolcenter. Vælg Formzeit fra Tilføj betjening. Åbn dit ur med ét tryk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte das Kontrollzentrum gedrückt. Wähle Formzeit über Steuerelement hinzufügen. Öffne deine Uhr mit einem Tippen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold Control Center. Choose Formzeit from Add a Control. Open your clock with one tap."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado el Centro de control. Elige Formzeit en Añadir un control. Abre tu reloj con un toque."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä Ohjauskeskusta painettuna. Valitse Formzeit kohdasta Lisää säädin. Avaa kello yhdellä napautuksella."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez le doigt dans le Centre de contrôle. Choisissez Formzeit dans Ajouter une commande. Ouvrez l’horloge d’un toucher."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentuh dan tahan Pusat Kontrol. Pilih Formzeit dari Tambah Kontrol. Buka jam dengan sekali ketuk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto il Centro di Controllo. Scegli Formzeit da Aggiungi un controllo. Apri l’orologio con un tocco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントロールセンターを長押しし、コントロールを追加からFormzeitを選びます。ワンタップで時計を開けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제어 센터를 길게 누르고 제어 추가에서 Formzeit를 선택하세요. 한 번의 탭으로 시계를 여세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold inne i Kontrollsenter. Velg Formzeit fra Legg til kontroll. Åpne klokken med ett trykk."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd het bedieningspaneel ingedrukt. Kies Formzeit via Voeg een regelaar toe. Open je klok met één tik."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj Centrum sterowania. Wybierz Formzeit z Dodaj narzędzie. Otwórz zegar jednym stuknięciem."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha a Central de Controle pressionada. Escolha Formzeit em Adicionar Controle. Abra o relógio com um toque."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ține apăsat Centrul de control. Alege Formzeit din Adaugă o comandă. Deschide ceasul cu o atingere."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте Пункт управления. Выберите Formzeit через добавление элемента управления. Откройте часы одним нажатием."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll ned i Kontrollcenter. Välj Formzeit från Lägg till ett reglage. Öppna klockan med ett tryck."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะศูนย์ควบคุมค้างไว้ เลือก Formzeit จากเพิ่มตัวควบคุม เปิดนาฬิกาด้วยการแตะครั้งเดียว"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Denetim Merkezi’ne basılı tut. Denetim Ekle’den Formzeit’i seç. Saat uygulamasına tek dokunuşla ulaş."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nhấn giữ Trung tâm điều khiển. Chọn Formzeit từ Thêm điều khiển. Mở đồng hồ bằng một lần chạm."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "长按控制中心。从添加控制中选择Formzeit。轻点一下即可打开时钟。"
          }
        }
      }
    },
