    "Saat ayarlarını açmak için dokun." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط لفتح إعدادات الساعة."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk for at åbne urets indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe, um die Uhreinstellungen zu öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap to open clock settings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca para abrir los ajustes del reloj."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avaa kellon asetukset napauttamalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez pour ouvrir les réglages de l’horloge."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ketuk untuk membuka pengaturan jam."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca per aprire le impostazioni dell’orologio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タップして時計の設定を開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "탭하여 시계 설정을 여세요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trykk for å åpne klokkeinnstillinger."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik om klokinstellingen te openen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stuknij, aby otworzyć ustawienia zegara."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque para abrir os ajustes do relógio."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Atinge pentru a deschide configurările ceasului."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите, чтобы открыть настройки часов."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryck för att öppna klockinställningar."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะเพื่อเปิดการตั้งค่านาฬิกา"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat ayarlarını açmak için dokun."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chạm để mở cài đặt đồng hồ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点打开时钟设置。"
          }
        }
      }
    },
    "Saat kadranına basılı tut. Düzenle › Komplikasyonlar’dan Formzeit’i seç. Akıllı Gruplama’ya da ekleyebilirsin." : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مطولًا على واجهة الساعة. تعديل › إضافات › Formzeit. يمكنك إضافته أيضًا إلى الحزمة الذكية."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold fingeren på urskiven. Rediger › Komplikationer › Formzeit. Du kan også føje det til Smart stak."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte das Zifferblatt gedrückt. Bearbeiten › Komplikationen › Formzeit. Du kannst es auch zum Smart-Stapel hinzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touch and hold the watch face. Edit › Complications › Formzeit. You can also add it to the Smart Stack."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsada la esfera. Editar › Complicaciones › Formzeit. También puedes añadirlo al Grupo Inteligente."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pidä kellotaulua painettuna. Muokkaa › Komplikaatiot › Formzeit. Voit lisätä sen myös älykkääseen pinoon."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez le doigt sur le cadran. Modifier › Complications › Formzeit. Vous pouvez aussi l’ajouter à la pile intelligente."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sentuh dan tahan wajah jam. Edit › Komplikasi › Formzeit. Kamu juga bisa menambahkannya ke Tumpukan Cerdas."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuto il quadrante. Modifica › Complicazioni › Formzeit. Puoi aggiungerlo anche alla Raccolta smart."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "文字盤を長押しします。編集 › コンプリケーション › Formzeit。スマートスタックにも追加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시계 페이스를 길게 누르세요. 편집 › 컴플리케이션 › Formzeit. 스마트 스택에도 추가할 수 있어요."
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hold inne på urskiven. Rediger › Komplikasjoner › Formzeit. Du kan også legge den i Smart stabel."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Houd de wijzerplaat ingedrukt. Wijzig › Complicaties › Formzeit. Je kunt deze ook toevoegen aan de slimme stapel."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przytrzymaj tarczę zegarka. Edytuj › Komplikacje › Formzeit. Możesz też dodać do stosu inteligentnego."
          }
        },
        "pt" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantenha o mostrador pressionado. Editar › Complicações › Formzeit. Também pode adicionar ao Conjunto Inteligente."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ține apăsat cadranul ceasului. Editează › Complicații › Formzeit. Îl poți adăuga și în Stiva inteligentă."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Удерживайте циферблат. Изменить › Расширения › Formzeit. Можно добавить и в Смарт-стопку."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Håll ned på urtavlan. Redigera › Komplikationer › Formzeit. Du kan också lägga till den i den smarta traven."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "แตะหน้าปัดนาฬิกาค้างไว้ แก้ไข › กลไกหน้าปัด › Formzeit เพิ่มในวิดเจ็ตซ้อนอัจฉริยะได้ด้วย"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saat kadranına basılı tut. Düzenle › Komplikasyonlar’dan Formzeit’i seç. Akıllı Gruplama’ya da ekleyebilirsin."
          }
