    "Kendi rengin, kendi şehrin. Tek veya çift analog saat.": {
      "extractionState": "manual",
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi rengin, kendi şehrin. Tek veya çift analog saat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your color, your city. One or two analog clocks."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Farbe, deine Stadt. Eine oder zwei Analoguhren."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre couleur, votre ville. Une ou deux horloges analogiques."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu color, tu ciudad. Uno o dos relojes analógicos."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo colore, la tua città. Uno o due orologi analogici."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لونك ومدينتك. ساعة أو ساعتان بعقارب."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din farve, din by. Et eller to analoge ure."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jouw kleur, jouw stad. Eén of twee analoge klokken."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinun värisi ja kaupunkisi. Yksi tai kaksi analogista kelloa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Warnamu, kotamu. Satu atau dua jam analog."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの色、あなたの街。1つまたは2つのアナログ時計。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나만의 색, 나만의 도시. 하나 또는 두 개의 아날로그 시계."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Din farge, din by. Én eller to analoge klokker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój kolor, Twoje miasto. Jeden lub dwa zegary analogowe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua cor, sua cidade. Um ou dois relógios analógicos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Culoarea ta, orașul tău. Unul sau două ceasuri analogice."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваш цвет, ваш город. Одни или двое аналоговых часов."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的色彩，你的城市。一个或两个模拟时钟。"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din färg, din stad. En eller två analoga klockor."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สีของคุณ เมืองของคุณ นาฬิกาอะนาล็อกหนึ่งหรือสองเรือน"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Màu của bạn, thành phố của bạn. Một hoặc hai đồng hồ kim."
          }
        }
      }
    },
